{
	"model": "Qwen/Qwen2.5-72B-Instruct",
    "provider": "nebius",
    "inputs": [
        {
            "type": "promptString",
            "id": "github-read-pat",
            "description": "Github Personal Access Token (read-only)",
            "password": true
        },
        {
            "type": "promptString",
            "id": "hf-token",
            "description": "Your Hugging Face Token",
            "password": true
        }
    ],
	"servers": [
		{
            "type": "stdio",
            "config": {
              "command": "docker",
              "args": [
                "run",
                "-i",
                "--rm",
                "-e",
                "GITHUB_PERSONAL_ACCESS_TOKEN",
                "-e",
                "GITHUB_TOOLSETS=repos",
                "ghcr.io/github/github-mcp-server"
              ],
              "env": {
                "GITHUB_PERSONAL_ACCESS_TOKEN": "${input:github-read-pat}"
              }
            }
          },
        {
			"type": "stdio",
			"config": {
				"command": "npx",
				"args": ["@playwright/mcp@latest"]
			}
		},
        {
            "type": "http",
            "config": {
                "url": "https://huggingface.co/mcp",
                "headers": {
                    "Authorization": "${HF_TOKEN}"
                }
            },
            "env": {
                "HF_TOKEN": "${input:hf-token}"
            }
        },
        {
            "type": "stdio",
            "config": {
                "command": "docker",
                "args": ["run", "-i", "--rm", "mcp/pdf-reader"]
            }
        }
	]
}